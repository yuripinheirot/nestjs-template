{
  "name": "nestjs-template",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch --debug 0.0.0.0:9229",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "yarn node --expose-gc --no-compilation-cache ./node_modules/.bin/jest --detectOpenHandles --forceExit --runInBand --logHeapUsage --passWithNoTests --noStackTrace",
    "test:v": "yarn node --expose-gc --no-compilation-cache ./node_modules/.bin/jest --detectOpenHandles --forceExit --logHeapUsage",
    "test:w": "yarn test --verbose --watch",
    "test:c": "yarn test --coverage",
    "test:u": "yarn test -c jest-unit-config.js",
    "test:f": "yarn test:v -c jest-feature-config.js",
    "generate": "rm -rf ./prisma/factory/generated && prisma generate",
    "migrate": "npx prisma migrate dev",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.0.5",
    "@prisma/client": "^6.14.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.14.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jest": "^30.0.5",
    "prettier": "^3.5.2",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2"
  }
}
